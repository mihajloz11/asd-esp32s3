{
  "schema_version": "asd-interference-policy-v3.0.0-development",
  "developmental": true,
  "numeric_status": "runtime_derived_from_session_normal_only_cal",
  "target_anomalies_used_for_fit": false,
  "public_state": "OBSERVATION_HOLD",
  "forbidden_single_microphone_diagnosis": "AMBIENT_NOISE_CATEGORY",
  "policy": {
    "enabled": true,
    "use_tonalness_delta": false,
    "max_abs_tonalness_delta": 0.547454,
    "normal_max_multiplier": 1.25,
    "calibration_min_windows": 10,
    "max_subsegment_instability_initial": 0.0,
    "long_hold_windows": 6
  },
  "runtime_derivation": {
    "source": "CAL_NORMAL_ONLY",
    "rule": "max(session CAL subsegment_instability) * normal_max_multiplier",
    "fit_fields_forbidden": [
      "airflow_change_paper_1",
      "airflow_change_paper_2",
      "airflow_change_paper_3",
      "ambient_speech",
      "ambient_door"
    ],
    "rationale": "Apsolutna v2 granica je nosila skalu starog polozaja mikrofona. V3 ponavlja isto normal-only pravilo po sesiji, bez ciljnih uslova."
  },
  "semantics": {
    "hold_is_reliability_not_category": true,
    "hold_suspends_alarm_buildup": true,
    "hold_clears_active_alarm": false,
    "hold_changes_profile": false,
    "stable_high_after_hold_starts_fresh_run": true,
    "long_hold_is_warning_not_normal": true
  },
  "change_rule": "Mnozilac i minimalni broj prozora smiju se izvoditi samo iz normal-only podataka. Ciljne anomalije sluze samo za zamrznutu regresionu provjeru i ne smiju mijenjati fit."
}
