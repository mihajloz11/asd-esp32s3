models/*.npz
results/*.wav
.venv-ci/
.venv-bare/
results/mjerenje_2026-09-21/backup/*.bin
results/mjerenje_2026-09-21/build/
radovi/telfor2026/sablon/*.pdf
radovi/telfor2026/primjeri/*.pdf
