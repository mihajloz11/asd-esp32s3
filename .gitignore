# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data & artifacts (veliki fajlovi — eksterni disk/cloud, ne git)
data/
models/*.h5
models/*.keras
models/*.tflite
results/*.npy
results/features/
# Demo zvuk se pravi iz DCASE skupa (psd_live_demo.py); manifest sa spiskom
# klipova IDE u git, sami WAV-ovi ne.
results/demo_audio/*.wav
# Isto za dugu probu laznih alarma (false_alarm_test.py): manifest, CSV i
# izvjestaj IDU u git, generisani WAV-ovi ne.
results/false_alarm/audio/*.wav
# Feature kesevi advanced evaluatora (evaluate_advanced.py,
# derive_temporal_policy.py) — regenerisu se iz DCASE skupa za par minuta.
# advanced_results.json i faza7_inventory.json IDU u git, kesevi ne.
results/advanced/*.npz

# Rezultati koji IDU u git: results/*.csv, results/*.png, models/*.json

# ESP-IDF
firmware/esp32s3_asd/build/
firmware/esp32s3_asd/managed_components/
firmware/esp32s3_asd/sdkconfig
firmware/esp32s3_asd/sdkconfig.old
firmware/esp32s3_asd/dependencies.lock

# OS/editor
.vscode/
Thumbs.db

# Kes featura i medjurezultati (veliki, regenerisu se iz data/)
