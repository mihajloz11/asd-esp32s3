# Zajednički defaults za oba targeta (esp32s3 / esp32).
# Target se bira sa: idf.py set-target esp32s3   (ili esp32)
# Per-target specifičnosti: sdkconfig.defaults.esp32s3 / sdkconfig.defaults.esp32

# CPU 240 MHz fiksno (mjerna validnost, plan 6.3)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Veći main task stack (TFLM init)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_PARTITION_TABLE_CUSTOM=y
